# Copy this file to .env.local for local work. On the host (Vercel/Netlify), add the same
# names under Environment Variables. Never commit real values.

# --- Catalogue (Sanity) ---------------------------------------------------
# Leave empty to run with built-in sample products (preview mode).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Orders (Google Sheet via Apps Script) ---------------------------------
# See docs/ORDERS-SETUP.md. Without these, the checkout shows a WhatsApp fallback
# instead of taking orders.
ORDERS_WEBHOOK_URL=
ORDERS_WEBHOOK_SECRET=

# --- Public site address (no trailing slash) -------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Optional ----------------------------------------------------------------
# Meta Pixel ID can be set in the Studio (Site settings). This is only a fallback.
# NEXT_PUBLIC_META_PIXEL_ID=
# Testing only, preview mode: lets WhatsApp buttons show before the Studio is connected.
# WHATSAPP_NUMBER=
